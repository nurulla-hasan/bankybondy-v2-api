# ══════════════════════════════════════════════════════════════════════
#  BankyBondy · API · entorno LOCAL (desarrollo)
#  REQUERIDO = src/app/config/index.ts aborta el arranque si falta/vacío.
#  En producción además abortan los pagos críticos (PAYPAL_*, MP_*).
# ══════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=Banky Bondy
PORT=5000
BASE_URL=18.231.80.188
# SOCKET_PORT: sin uso en el backend (legado; el front usa NEXT_PUBLIC_SOCKET_URL)
# SOCKET_PORT=9000

# ── Base de datos / Redis ──────────────────────────────────────────────
# REQUERIDO. Atlas: mongodb+srv://... | Docker en VPS: mongodb://admin:...@mongo-bondtest:27017/bankybondy?replicaSet=rs0&authSource=admin
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# ── JWT / auth ─────────────────────────────────────────────────────────
# REQUERIDOS: los secretos NO pueden quedar vacíos (el boot aborta).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=365d
BCRYPT_SALT_ROUNDS=8
RESET_PASSWORD_UI_LINK=http://localhost:3000/?
GOOGLE_CLIENT_ID=

# ── Super admin (bootstrap) ────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Email (SMTP) ───────────────────────────────────────────────────────
SMTP_SERVICE=gmail
SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_MAIL=
SMTP_PASS=
# Remitente visible. En prod debe ser del dominio verificado (no el usuario SMTP).
EMAIL_FROM=Bankybondy <notificaciones@bankybondy.com>

# ── Archivos / audio (S3 + CloudFront) ─────────────────────────────────
AWS_REGION=sa-east-1
AWS_S3_BUCKET_NAME=banky-bondy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=https://d19ily4n4ue4ad.cloudfront.net
AUDIO_STUCK_MINUTES=45
# Ruta local de ffmpeg (solo Windows; en Docker usa el del PATH).
AUDIO_FFMPEG_PATH=C:/Users/golap/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe

# ── OpenAI (embeddings del matcheo + moderación) ───────────────────────
# REQUERIDO.
OPENAI_API_KEY=

# ── Pagos · PayPal ─────────────────────────────────────────────────────
# En producción CLIENT_ID/SECRET/MODE/CAPTURE_URL/WEBHOOK_ID son obligatorios.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=6NE0445986079142Y
PAYPAL_PAYMENT_CAPTURE_URL=
DONATION_SUCCESS_URL=http://bankybondy.com/success
DONATION_CANCEL_URL=http://bankybondy.com/cancel

# ── Pagos · MercadoPago ────────────────────────────────────────────────
# En producción ACCESS_TOKEN y WEBHOOK_SECRET son obligatorios (fail-closed).
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SUCCESS_URL=https://bankybondy.com/success
MP_FAILURE_URL=https://bankybondy.com/cancel
MP_PENDING_URL=https://bankybondy.com/success

# ── Stripe: DESMONTADO (nada del código lo lee) ────────────────────────
STRIPE_SECRET_KEY=
WEBHOOK_ENDPOINT_SECRET=
STRIPE_PAYMENT_SUCCESS_URL=https://localhost:3000/success
STRIPE_PAYMENT_CANCEL_URL=https://localhost:3000/cancel

# ── Notificaciones ─────────────────────────────────────────────────────
# Digest por email: 'true' habilita el cron.
DIGEST_ENABLED=true

# ── Matcheo · candidatos ───────────────────────────────────────────────
# knn = kNN exacto en memoria. Sin este flag usa $vectorSearch de Atlas.
MATCH_CANDIDATE_MODE=knn
# TTL del snapshot kNN (ms). Bajarlo recalcula más seguido (más CPU/DB).
MATCH_KNN_SNAPSHOT_TTL_MS=3000
MATCH_NUM_CANDIDATES=500
MATCH_FRONTIER_SEEDS=5
MATCH_FRONTIER_NUM_CANDIDATES=100

# ── Matcheo · scoring ──────────────────────────────────────────────────
# 'surprise' contra un vínculo concreto paga floor + margin.
MATCH_SURPRISE_FLOOR=0.4
MATCH_SURPRISE_MARGIN=0.05
# Preferencia SUAVE por cadenas cortas (size 2 = 0; 3 = -bias; ...).
MATCH_PAIR_BIAS=0.02

# ── Matcheo · worker / sweep ───────────────────────────────────────────
MATCH_SWEEP_ENABLED=true
MATCH_SWEEP_CRON="*/30 * * * *"
MATCH_SWEEP_BATCH=50
MATCH_WORKER_CONCURRENCY=4
# "¿Conviene REFRESCAR la caché?" (el TTL de "seguir mostrando" es otro: 48 h).
MATCH_CACHE_TTL_MINUTES=180

# ── Matcheo · read model (BondMatchFeed) ───────────────────────────────
# WRITE puebla el feed; READ sirve desde el feed. Van juntos (rollback: ambos false).
MATCH_FEED_WRITE=true
MATCH_FEED_READ=true
