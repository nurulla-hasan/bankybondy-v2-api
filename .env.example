# ══════════════════════════════════════════════════════════════════════
#  BankyBondy · API · LOCAL environment (development)
#  REQUIRED = src/app/config/index.ts aborts boot if missing/empty.
#  In production the critical payment vars also abort (PAYPAL_*, MP_*).
# ══════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=Banky Bondy
PORT=5000
BASE_URL=18.231.80.188
# SOCKET_PORT: unused in the backend (legacy; the front uses NEXT_PUBLIC_SOCKET_URL)
# SOCKET_PORT=9000

# ── Database / Redis ───────────────────────────────────────────────────
# REQUIRED. Atlas: mongodb+srv://... | Docker on VPS: mongodb://admin:...@mongo-bondtest:27017/bankybondy?replicaSet=rs0&authSource=admin
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# ── JWT / auth ─────────────────────────────────────────────────────────
# REQUIRED: the secrets must NOT be empty (boot aborts).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=365d
BCRYPT_SALT_ROUNDS=8
RESET_PASSWORD_UI_LINK=http://localhost:3000/?
GOOGLE_CLIENT_ID=

# ── Super admin (bootstrap) ────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Email (SMTP) ───────────────────────────────────────────────────────
SMTP_SERVICE=gmail
SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_MAIL=
SMTP_PASS=
# Visible sender. In prod must be a verified domain (not the SMTP user).
EMAIL_FROM=Bankybondy <notificaciones@bankybondy.com>

# ── Files / audio (S3 + CloudFront) ────────────────────────────────────
AWS_REGION=sa-east-1
AWS_S3_BUCKET_NAME=banky-bondy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=https://d19ily4n4ue4ad.cloudfront.net
AUDIO_STUCK_MINUTES=45
# Local ffmpeg path (Windows only; Docker uses the one in PATH).
AUDIO_FFMPEG_PATH=C:/Users/golap/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe

# ── OpenAI (matching embeddings + moderation) ──────────────────────────
# REQUIRED.
OPENAI_API_KEY=

# ── Payments · PayPal ──────────────────────────────────────────────────
# In production CLIENT_ID/SECRET/MODE/CAPTURE_URL/WEBHOOK_ID are mandatory.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=6NE0445986079142Y
PAYPAL_PAYMENT_CAPTURE_URL=
DONATION_SUCCESS_URL=http://bankybondy.com/success
DONATION_CANCEL_URL=http://bankybondy.com/cancel

# ── Payments · MercadoPago ─────────────────────────────────────────────
# In production ACCESS_TOKEN and WEBHOOK_SECRET are mandatory (fail-closed).
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SUCCESS_URL=https://bankybondy.com/success
MP_FAILURE_URL=https://bankybondy.com/cancel
MP_PENDING_URL=https://bankybondy.com/success

# ── Notifications ──────────────────────────────────────────────────────
# Email digest: 'true' enables the cron.
DIGEST_ENABLED=true