# ==============================================================
# BankyBondy Backend Environment Example
# ==============================================================

NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Put your MongoDB URI here
DATABASE_URL=mongodb://localhost:27017/bankybondy

BCRYPT_SALT_ROUNDS=10

JWT_ACCESS_SECRET=bankybondy_jwt_access_secret_key_2026_dev_secure
JWT_REFRESH_SECRET=bankybondy_jwt_refresh_secret_key_2026_dev_secure
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

SUPER_ADMIN_EMAIL=admin@bankybondy.com
SUPER_ADMIN_PASSWORD=Admin@12345
DEFAULT_PASS=User@12345

OPENAI_API_KEY=sk-dev-dummy-key-replace-with-real-key-if-using-ai
